    {
      "type": "timeseries",
      "title": "Time to first word",
      "description": "From sending to the first word, over the selected window. Thinking replies count their reasoning here.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
