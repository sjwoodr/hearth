{
  "title": "hearth",
  "uid": "hearth",
  "description": "hearth's replies, model speed, scheduler and background work (server/metrics.ts).",
  "tags": [
    "hearth"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(hearth_model_preemptions_total, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(hearth_model_preemptions_total, namespace)",
        "refresh": 2,
        "current": {},
        "hide": 0
      },
      {
        "name": "node",
        "label": "Node (memory panel)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(node_uname_info, nodename)",
          "refId": "node"
        },
        "definition": "label_values(node_uname_info, nodename)",
        "refresh": 2,
        "current": {},
        "hide": 0
      },
      {
        "name": "window",
        "label": "Window",
        "type": "custom",
        "query": "15m,1h,6h,24h",
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "hide": 0,
        "description": "Rates and percentiles are computed over this window: wider is smoother with few replies.",
        "options": [
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview (over the selected time range)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Replies",
      "description": "Replies that finished in the time range, any outcome.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(hearth_replies_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Median first word",
      "description": "Half of replies showed their first word faster than this: waiting for a slot, recall, reading the prompt. A cold model load adds ~16 s.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(hearth_reply_first_token_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Median tokens/s (replies)",
      "description": "Generation speed from Ollama's own counts. One reply alone ~23 tok/s; two at once ~17 each.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(hearth_model_tokens_per_second_bucket{namespace=\"$namespace\",kind=\"reply\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
