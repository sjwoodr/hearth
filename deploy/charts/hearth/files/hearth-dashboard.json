      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, think) (rate(hearth_reply_first_token_seconds_bucket{namespace=\"$namespace\"}[$window])))",
          "legendFormat": "median, think={{think}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, think) (rate(hearth_reply_first_token_seconds_bucket{namespace=\"$namespace\"}[$window])))",
          "legendFormat": "p95, think={{think}}",
          "refId": "B"
