# Copy to .env and adjust. .env is gitignored; never commit real values.
# Every value below is also the built-in default (server/config.ts), so hearth runs without a .env;
# set only what you want to change.

# Backend listens here. Keep it on localhost: Caddy is the only thing that
# should reach it.
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8787

# Public origin clients use (through Caddy). Used for the Secure cookie and
# origin checks.
HEARTH_ORIGIN=https://hearth.example.com

# SQLite database file (conversations, messages, memories, users, sessions).
HEARTH_DB_PATH=./data/hearth.db

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
# Picked by the French bench: 153/158, ~1.2 s per answer, 15 GB loaded.
HEARTH_MODEL=gemma4:26b-a4b-it-qat
# Used with thinking on when the in-app Think toggle is on. Same model as above = one copy in memory.
HEARTH_MODEL_THINKING=gemma4:26b-a4b-it-qat
# Reasoning tokens before the model is stopped and asked to answer. 200 kept full grading accuracy
# on the bench while capping the wait (~12-15 s on the 26B instead of minutes).
HEARTH_THINKING_TOKEN_BUDGET=200
# Context window. The summarizer scales with it (summarize past half, keep a quarter verbatim).
HEARTH_NUM_CTX=16384
HEARTH_EMBED_MODEL=embeddinggemma:300m-qat-q8_0

# Memory extraction runs on a chat once it has been idle this long.
HEARTH_MEMORY_IDLE_MINUTES=5

# Personality: the system prompt file, re-read on every message.
HEARTH_SYSTEM_PROMPT=./prompts/system.md

# The Cloudflare API token for Let's Encrypt DNS-01 belongs to Caddy, not this
# app. Keep it in Caddy's own environment file on the host, not here.
