# Production images (the dev image is ./Dockerfile). Two targets from one build:
#   docker build -f Dockerfile.prod --target server -t hearth .      api, worker, gateway, migrate
#   docker build -f Dockerfile.prod --target web    -t hearth-web .  the built front end on nginx
# The server image runs any role by its command:
#   node server/index.ts (default: the api; HEARTH_ROLE=api|all) · node server/worker.ts
#   node server/gateway-main.ts · node server/migrate.ts
# Base images are pinned by digest so a rebuild can't change underneath; bump them deliberately.

# ---- build: install everything, compile better-sqlite3, build the front end, drop dev deps ----
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g pnpm@10.18.0
WORKDIR /app
# Dependencies first, so a code change doesn't redo the install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build && pnpm prune --prod

# ---- server: Node, production dependencies and the code; no compilers ----
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS server
# tini as PID 1 passes SIGTERM to Node, so graceful shutdown works (server/shutdown.ts).
# npm isn't needed to run, so it goes (smaller, and less for a scanner to flag).
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/* \
 && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
ENV NODE_ENV=production \
    HEARTH_HOST=0.0.0.0 \
    HEARTH_DB_PATH=/data/hearth.db
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server ./server
COPY --from=build /app/shared ./shared
COPY --from=build /app/prompts ./prompts
COPY --from=build /app/bin ./bin
COPY --from=build /app/dist ./dist
# The database lives on a volume, written by the image's uid 1000 (node).
RUN mkdir -p /data && chown node:node /data
VOLUME /data
USER node
EXPOSE 8787 8788 11435
ENTRYPOINT ["tini", "--"]
CMD ["node", "server/index.ts"]

# ---- web: the built front end, served by unprivileged nginx on 8080 ----
FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 AS web
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/client /usr/share/nginx/html
EXPOSE 8080
