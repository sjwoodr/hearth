# Copy to bruno/.env (gitignored). Bruno reads it when it opens the collection; the environments
# use these as {{process.env.NAME}}. Reopen the collection after editing.

# The cluster environment's address (your hearth's HEARTH_ORIGIN).
HEARTH_URL=https://hearth.example.com
# A test user of its own (bin/hearth users add bruno), for both environments.
HEARTH_USERNAME=bruno
HEARTH_PASSWORD=
